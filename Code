    obstacles[1].position.x = (float)LARGEUR_ECRAN/2;
    obstacles[1].position.y = (float)-100;
    obstacles[1].position.largeur = LARGEUR_ECRAN;
    obstacles[1].position.hauteur = 200;

    // Obstacle virtuel : bord droit de l'écran
    obstacles[2].position.x = (float)LARGEUR_ECRAN+100;

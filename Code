bool verifierInitialisationSansCollision(Bulle *tete) {
    Bulle *bulle = tete;
    while (bulle != NULL) {
        for (int i = 0; i < N_OBSTACLES; i++) {
            while (detecterCollisionBulle(bulle, &obstacles[i].position)==true) {
                return false;
            }
        }
        bulle = bulle->suivant;
    }
    return true;
}

void gererBulle(Bulle *bulle, Balle *tete_balle, Joueur *joueur, float cycle) {
    // Boucle d'animation pour plus de precision
    cycle /= NB_SOUS_CYCLE;
    for (int j=0 ; j<NB_SOUS_CYCLE ; j++) {
        // Effet de gravité sur les bulles
        bulle->position.vy += GRAVITE*cycle;
        // Frottement
       // bulle->position.vx -= FROTTEMENT * cycle * bulle->position.vx;
        //bulle->position.vy -= FROTTEMENT * cycle * bulle->position.vy;

        // Cinématique
        bulle->position.x += bulle->position.vx*cycle;
        bulle->position.y += bulle->position.vy*cycle;

        // Par défaut, pas de déformation
        bulle->position.largeur = 2*bulle->rayon;
        bulle->position.hauteur = 2*bulle->rayon;
        if (temps_restant < 100.0) {
            bulle->position.hauteur = 2*bulle->rayon;
        }

        for (int i = 0; i < N_OBSTACLES; i++) {
            if (detecterCollisionBulle(bulle, &obstacles[i].position)==true) {
                rebondBulleObstacle(bulle, &obstacles[i], cycle);
            }
        }
    }

    Balle *balle = tete_balle;
    while (balle != NULL) {
        if (detecterCollisionBulle(bulle, &balle->position) == true) {
            collisionBulleBalle(bulle, balle);
            balle->position.y = HORS_ZONE_JEU; //Supprime la balle grâce à la fonction supprimerBallesHorsZone
        }
    balle = balle->suivant;
    }
    if (detecterCollisionBulle(bulle, &joueur->position) == true) { // Si la bulle touche le joueur, le joueur perd.
        joueur_touche_par_bulle =true;
    }
    /*if (detecterCollisionBulle(bulle, &joueur->position) == true) {
               if (bouclier_actif) {
                   bouclier_actif = false;   // le bouclier absorbe le coup
                   bouclier_timer = 0.0f;
               } else {
                   joueur_touche_par_bulle = true;
               }
           }*/
}

void gererBalle(Balle *tete, float cycle) {
    Balle *balle = tete;
    while (balle != NULL) {
        // Cinématique
        balle->position.x += balle->position.vx * cycle;
        balle->position.y += balle->position.vy * cycle;
        for (int i = 0; i < N_OBSTACLES; i++) {
            if (detecterCollision(&obstacles[i].position, &balle->position) == true) {
                balle->position.y = HORS_ZONE_JEU; //Supprime la balle grâce à la fonction supprimerBallesHorsZone
            }
        }
        balle = balle->suivant;
    }
}

void rebondBulleObstacle(Bulle *bulle, const Obstacle *obstacle, float cycle) {
        float dx = bulle->position.x - obstacle->position.x;
        float dy = bulle->position.y - obstacle->position.y;
        float coin_x = (float)obstacle->position.largeur/2;
        float coin_y = (float)obstacle->position.hauteur/2;
        float rayon = (float)bulle->rayon;
        float c, s; // Cosinus et sinus de l'accélération vers l'extérieur de l'obstacle
        float dx1, dy1, r;

        if (dx >  coin_x + rayon) return; // pas de contact
        if (dx < -coin_x - rayon) return; // pas de contact
        if (dy >  coin_y + rayon) return; // pas de contact
        if (dy < -coin_y - rayon) return; // pas de contact

        if ((dx >= -coin_x) && (dx <= coin_x)) {
            c = 0;
            if (dy >= 0) {
                s = 1; // Accélération vers le bas
            } else {
                s = -1; // Accélération vers le haut
            }
        } else if ((dy >= -coin_y) && (dy <= coin_y)) {
            s = 0;
            if (dx >= 0) {
                c = 1; // Accélération vers la droite
                //printf("c=1 dx=%f\n", dx);
            } else {
                c = -1; // Accélération vers la gauche
            }
        } else { // Cas du contact en coin
            // Décalage vers le coin
            dx1 = dx;
            dy1 = dy;
            if (dx1 > 0) dx1 -=  coin_x;
            if (dx1 < 0) dx1 -= -coin_x;
            if (dy1 > 0) dy1 -=  coin_y;
            if (dy1 < 0) dy1 -= -coin_y;
            r = sqrtf(dx1*dx1 + dy1*dy1);
            if (r >= rayon) return; // pas de contact
            c = dx1/r;
            s = dy1/r;
        }

    // Rebond pour éviter une déformation trop grande
    float c2 = c*c;
    float s2 = s*s;
    float rebond_x = coin_x + rayon * DIST_REBOND_RATIO;
    float rebond_y = coin_y + rayon * DIST_REBOND_RATIO;
    if ((dx > -rebond_x) && (dx < rebond_x) && (dy > -rebond_y) && (dy < rebond_y)) {
        printf("Rebond vx=%f vy=%f\n", bulle->position.vx, bulle->position.vy);
        if (dx < 0) rebond_x = -rebond_x;
        if (dy < 0) rebond_y = -rebond_y;
        if ((c2 >= s2) && (bulle->position.vx * c < 0)) { // Rebond en x
            dx = 2 * rebond_x - dx;
            bulle->position.x = obstacle->position.x + dx;
            bulle->position.vx = -bulle->position.vx;
        }
        if ((s2 > c2) && (bulle->position.vy * s < 0)) { // Rebond en y
            dy = 2 * rebond_y - dy;
            bulle->position.y = obstacle->position.y + dy;
            bulle->position.vy = -bulle->position.vy;
        }
    }

    // Déformation de la bulle et accélération correspondante
    float deformation;
    float l,h;
    if (c == 0) { // Déformation en hauteur seulement
        h = fabsf(dy) - coin_y;
        deformation = rayon - h;
        bulle->position.hauteur = (int) (2*h);
    } else if (s == 0) { // Déformation en largeur seulement
        l = fabsf(dx) - coin_x;
        deformation = rayon - l;
        bulle->position.largeur = (int) (2*l);
        //printf("deforme x %f\n l=%d", deformation, bulle->position.largeur);
    } else { // Déformation en coin
        dx1 = dx;
        dy1 = dy;
        if (dx1 > 0) dx1 -=  coin_x;
        if (dx1 < 0) dx1 -= -coin_x;
        if (dy1 > 0) dy1 -=  coin_y;
        if (dy1 < 0) dy1 -= -coin_y;
        r = sqrtf(dx1*dx1 + dy1*dy1);
        if (r >= rayon) return; // pas de déformation, plus de contact
        c = dx1/r;
        s = dy1/r;
        c2 = c*c;
        s2 = s*s;
        if (c2 >= s2) {
            h = rayon + (fabsf(c) - 1) * (rayon - r) / (1 - SQRT2_DIV_2);
            l = r * fabsf(c) / sqrtf(1 - s2 * r * r / h / h);
            deformation = rayon - h;
        } else {
            l = rayon + (fabsf(s) - 1) * (rayon - r) / (1 - SQRT2_DIV_2);
            h = r * fabsf(s) / sqrtf(1 - c2 * r * r / l / l);
            deformation = rayon - l;
        }
        //printf("c=%f s=%f r=%f l=%f h=%f\n",c,s,r,l,h);
        bulle->position.largeur = (int) (2*l);
        bulle->position.hauteur = (int) (2*h);
    }
    bulle->position.vx += deformation * c * cycle / TEMPS_REBOND_2;
    bulle->position.vy += deformation * s * cycle / TEMPS_REBOND_2;

    // Limite la vitesse de la bulle
    float v = sqrtf((bulle->position.vx) * (bulle->position.vx) + (bulle->position.vy) * (bulle->position.vy));
    if (v > VITESSE_BULLE_MAX) {
        bulle->position.vx *= VITESSE_BULLE_MAX / v;
        bulle->position.vy *= VITESSE_BULLE_MAX / v;
    }
}


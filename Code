Boss *creerBoss()
{
    Boss *boss = malloc(sizeof(Boss));
    if (boss == NULL)
    {
        printf("Erreur allocation memoire.");
        exit(1);
    }
    boss->position.largeur = (40/100)* LARGEUR_ECRAN;
    boss->position.hauteur = (25/100)* HAUTEUR_ECRAN;
    boss->position.x = LARGEUR_ECRAN/2; // au mileu de l'écran
    boss->position.y = boss->position.hauteur/2; // en hait de l'écran
    boss->nb_tirs_recus = 0;
    boss->compteur_apparition_flamme = 3.0f;
    changerVitesseBoss(boss);
    return boss;
}

bool listeVide(void **tete) {
    if (*tete == NULL) {
        return true;
    } else {
        return false;
    }
}

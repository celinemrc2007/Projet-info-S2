#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <allegro.h>


#include "gestionGraphique.h"
#include "gestionNiveaux.h"
#include "sauvegarde.h"


int menu()
{
    int choix = 0;

    while (choix < 1 || choix > 4)
    {
        afficherFondEcran(0);
        afficherBuffer();
        int noir = makecol(0,0,0);
        int vert = makecol(50,220,50);

        afficherTexteCentre(screen, font, LARGEUR_ECRAN/2, 150, noir, -1, "SUPER BULLES");
        afficherTexteCentre(screen, font, LARGEUR_ECRAN/2, 250, vert, -1, "1. Regles");
        afficherTexteCentre(screen, font, LARGEUR_ECRAN/2, 300, vert, -1, "2. Nouvelle partie");
        afficherTexteCentre(screen, font, LARGEUR_ECRAN/2, 350, vert, -1, "3. Reprendre");
        afficherTexteCentre(screen, font, LARGEUR_ECRAN/2, 400, vert, -1, "4. Quitter");

        /* Lecture de la touche */
        int touche = readkey() & 0xff;

        /* Conversion caractère en nombre */
        choix = touche - '0';
    }

    return choix;
}


void saisirPseudo()
{
    int longueur = 0;
    int touche;

    memset(pseudo, 0, MAX_PSEUDO);

    while (1)
    {
        afficherFondEcran(0);
        afficherBuffer();
        afficherTexteCentre(screen, font, LARGEUR_ECRAN/2, 300, makecol(50,220,50), -1, "Entrez votre pseudo :");

        /* Affichage du pseudo */
        char txt[51];
        sprintf(txt, "%s_", pseudo);
        afficherTexteCentre(screen, font, LARGEUR_ECRAN/2, 360, makecol(0,0,0), -1, txt);

        touche = readkey() & 0xff;

        if (touche == 13 && longueur > 0) // Touche Entrée = 13 en ASCII
        {
            break;
        }
        if (touche == 8 && longueur > 0) // Touche Effacer = 8 en ASCII
        {
            longueur--;
            pseudo[longueur] = '\0';
        }
        /* Caractère normal */
        else if (longueur < MAX_PSEUDO - 1 && touche >= 32 && touche <= 126)
        {
            pseudo[longueur] = (char)touche;
            longueur++;
            pseudo[longueur] = '\0';
        }
    }
}


int main()
{
    int choix;

    srand(time(NULL));

    initialisation_allegro();
    chargerSprites();

    do
    {
        choix = menu();

        switch (choix)
        {
            case 1:
            	/* Afficher les regles */
                afficherRegles();
                break;

            case 2:
                /* Nouvelle partie */
                saisirPseudo();
                lancerNiveau();
                break;

            case 3:
                /* Reprendre une partie */
                saisirPseudo();

                if (chargerPartie(pseudo, &niveau))
                {
                    lancerNiveau();
                }
                else
                {
                	clear_bitmap(screen);
                    afficherTexteCentre(screen, font, LARGEUR_ECRAN/2, 300, makecol(255,0,0), -1, "Aucune sauvegarde ");
                    readkey();
                }
                break;

            case 4:
                /* Quitter le programme */
                break;
        }

    } while (choix != 4);
    detruireSprites();
    allegro_exit();
    return 0;
}

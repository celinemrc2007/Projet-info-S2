void animerElements(float cycle) {
    Balle *balle = tete_balle;
    while (balle != NULL) {
        gererBalle(balle, cycle);
        balle = balle->suivant;
    }
    Bulle *bulle = tete_bulle;
    while (bulle != NULL) {
        gererBulle(bulle, tete_balle, joueur, cycle);
        bulle = bulle->suivant;
    }
    Objet *objet = tete_objet;
    while (objet != NULL) {
        if (detecterCollision(&objet->position, &joueur->position) == true) {
            collisionJoueurObjet(objet, joueur);
        }
        objet = objet->suivant;
    }
    //ajouterBulleAleatoirement(&tete_bulle, niveau);
//    mettreAJourBouclier();
}

void initialiserListeBulle(int niveau) {
    srand((unsigned int)time(NULL));
    int nb_bulles;
    switch (niveau) {
        case 1: nb_bulles = 1; break;
        case 2: nb_bulles = 5; break;
        case 3: nb_bulles = 0; break;
        case 4: nb_bulles = 0; break;
        default: nb_bulles = 0; break;
    }

    for (int i = 0; i < nb_bulles; i++) {
        Bulle *bulle = creerBulle(true, niveau);
        ajouterBulle(&tete_bulle, bulle);
    }
}


void init(Balle *balle) {
    // initialiserListeBulle(bulle);
    initialiserListeBalle(balle);
    // Initialisation des caractériqtiques du joueur au début d'une partie
    joueur->position.x = LARGEUR_ECRAN/2;
    joueur->position.y = HAUTEUR_ECRAN/2 -100;
    joueur->position.vx = 0;
    joueur->position.vy = 0;
    joueur->position.hauteur =  HAUTEUR_ECRAN/5;
    joueur->position.largeur = 4/3*joueur->position.hauteur;
    joueur->arme = 0; // Arme par défaut

    // Initialisation des quatre types d'obstacles différents à des positions aléatoires dans la zone de jeu
    for (int i = 0; i < N; i++) {
        obstacles[i].position.y = 2*GRANDE_BULLE + rand() % (LARGEUR_ECRAN - obstacles[i].position.hauteur - 2*GRANDE_BULLE); // permet que les obstacles soient éloignés du bord
        obstacles[i].position.y = 2*GRANDE_BULLE + rand() % (HAUTEUR_ECRAN - obstacles[i].position.hauteur - 2*GRANDE_BULLE); // permet que les obstacles soient éloignés du bord
    }
    // Deux tailles d'obstacles horizontaux
    obstacles[0].position.largeur = 15/100*LARGEUR_ECRAN;
    obstacles[0].position.hauteur = 3/100*HAUTEUR_ECRAN;
    obstacles[1].position.largeur = 30/100*LARGEUR_ECRAN;
    obstacles[1].position.hauteur = 3/100*HAUTEUR_ECRAN;
    // Deux tailles d'obstacles verticaux
    obstacles[2].position.largeur = 3/100*LARGEUR_ECRAN;
    obstacles[2].position.hauteur = 15/100*HAUTEUR_ECRAN;
    obstacles[3].position.largeur = 3/100*LARGEUR_ECRAN;
    obstacles[3].position.hauteur = 30/100*HAUTEUR_ECRAN;
}

bool jeu() {
    Balle *balle;
    init(balle);
    float temps_restant_initial = temps_restant;
    joueur_touche_par_bulle = false;
    joueur_touche_par_eclair = false;

    while (temps_restant > 0) {
        afficherElements();
        animerElements(CYCLE);
    /*
        deplacementsJoueur(Joueur *joueur);
        tirerBallesBombes(Balle *balle);
        */
        if ((temps_restant <= temps_restant_initial-TEMPS_JEU_MINIMUM) && (listeVide() == true)) {
            return true;
        } else if (joueur_touche_par_bulle =true) { // Si la bulle touche le joueur, le joueur perd.
                return false;
        } else if (joueur_touche_par_eclair == true) { //Si le joueur touche un éclair, il perd.
        return false;
        }
        temps_restant -= CYCLE;
    }
    return false;
}


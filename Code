 /* ================= Constantes pour le boss ================= */
#define TEMPS_INITIAL_CHANGEMENT_VITESSE 4.0f // en secondes
#define TEMPS_FINAL_CHANGEMENT_VITESSE 1.5f   // en secondes
#define VITESSE_INITIALE 300.0f
#define VITESSE_FINALE 800.0f
#define TEMPS_MOYEN_EJECTION_FLAMME 8.0f


/* ================= VARIABLES GLOBALES ================= */

int niveau = 1;                 // niveau courant
char pseudo[MAX_PSEUDO];
float compteur_bouclier;
float compteur_malus;
int facteur_apparition_bulle;
bool joueur_touche_par_boss;

/* ================= PERMET DE PASSER LE PARAMETRE NIVEAU A CERTAINES SOUS-PROGRAMMES ================= */

int recupererNiveau() {
    return niveau;
}

/* ================= LANCEMENT NIVEAU ================= */

void lancerNiveau() {
    afficherFondEcran(niveau);

    switch (niveau) {
        case 1:
            temps_restant = 120; // 2 min
            break;

        case 2:
            temps_restant = 105; // 1 min 45
            break;

        case 3:
            temps_restant = 90; // 1 min 30
            break;
        case 4:
            temps_restant = 75; // 1 min 15
            break;

          case 5:
            temps_restant = 60; // 1 min
            break;
    }
    afficherNiveau(niveau);
    int resultat_jeu = jeu();
    if (resultat_jeu==true) {
        if (niveau != 4) {
            gererVictoireNiveau ();
        } else {
            boss = creerBoss();
            temps_restant = 75;
            resultat_jeu = jeu();
            if (resultat_jeu==true) {
                gererVictoirePartie();
            }  else {
                gererEchecNiveau();
            }
        }
    } else {
        gererEchecNiveau();
    }
}

/* ================= FIN NIVEAU APRES ANIMATION ================= */
void finNiveau() {
    int choix = 0;
    int choix_realise = 0;

    afficherFondEcran(niveau);
    int x = LARGEUR_ECRAN/2 - 250;
    int y = HAUTEUR_ECRAN/2 - 100;
    int noir = makecol(0, 0, 0);

    afficherTexte(screen, font, x, y, noir, -1, "Que souhaites-tu faire ?");
    afficherTexte(screen, font, x, y + 60, noir, -1, "1. Continuer");
    afficherTexte(screen, font, x, y + 100, noir, -1, "2. Sauvegarder et revenir au menu");
    afficherTexte(screen, font, x, y + 140, noir, -1, "3. Sauvegarder et quitter le jeu");
    afficherTexte(screen, font, x, y + 180, noir, -1, "4. Quitter le jeu sans sauvegarder");

    while (!choix_realise) {
        if (keypressed()) {
            int touche = readkey();
            char ascii = touche & 0xFF; // Récupération du caractère ASCII

            if (ascii >= '1' && ascii <= '4') {  // Conversion du caractère en chiffre entier
                choix = ascii - '0';
                choix_realise = 1; // On sort de la boucle une fois le choix realise
            }
        }
    }

    switch(choix) {
        case 1:
            lancerNiveau();
            break;
        case 2:
            sauvegarderPartie(pseudo, niveau);
            menu();
            break;
        case 3:
            sauvegarderPartie(pseudo, niveau);
            menu();
            break;
        case 4:
            menu();
            break;
    }
}

/* ================= VICTOIRE NIVEAU ================= */

void gererVictoireNiveau() {
    if (niveau == 5) {
        menu();
    } else {
        afficherBoss(boss);
        afficherVictoireNiveau(joueur);
        niveau++;
        finNiveau();
    }
}

/* ================= ECHEC NIVEAU ================= */

void gererEchecNiveau() {
        afficherEchecNiveau(joueur);
        finNiveau();
}

/* ================= VICTOIRE PARTIE ================= */

void gererVictoirePartie() {
    afficherVictoirePartie();
    finNiveau();
}


/* ============== GESTION DU BOSS =========== */

void changerVitesseBoss (Boss *boss) {
    float vitesse = VITESSE_INITIALE + (VITESSE_FINALE - VITESSE_INITIALE) *
            boss->nb_tirs_recus/NB_MAX_TIRS_RECUS;
    float angle = rand()%1000 + 1; // angle compris entre 1 et 1000
    boss->position.vx = vitesse * cosf(angle);
    boss->position.vy = vitesse * sinf(angle);
    float temps_changement_vitesse = TEMPS_INITIAL_CHANGEMENT_VITESSE +
        (TEMPS_FINAL_CHANGEMENT_VITESSE - TEMPS_INITIAL_CHANGEMENT_VITESSE) *
            boss->nb_tirs_recus/NB_MAX_TIRS_RECUS;
    boss->compteur_changement_vitesse = (rand() % 40 + 80) / 100.0f * temps_changement_vitesse;
}

void gererBoss (Boss *boss, Joueur *joueur, Balle *tete_balle, float cycle) {
    if (boss == NULL) return;

    // Changement de vitesse aléatoire
    boss->compteur_changement_vitesse -= cycle;
    if (boss->compteur_changement_vitesse < 0) {
        changerVitesseBoss(boss);
    }

    //Cinematique
    boss->position.x += boss->position.vx * cycle;
    boss->position.y += boss->position.vy * cycle;
    if ((boss->position.x - boss->position.largeur/2 < 50) && (boss->position.vx < 0)) {
        boss->position.vx = - boss->position.vx;
    }
    if ((boss->position.x + boss->position.largeur/2 > LARGEUR_ECRAN - 50) && (boss->position.vx > 0)) {
        boss->position.vx = - boss->position.vx;
    }
    if ((boss->position.y - boss->position.hauteur/2 < 50) && (boss->position.vy < 0)) {
        boss->position.vy = - boss->position.vy;
    }
    if ((boss->position.y - boss->position.hauteur/2 > ZONE_JEU_HAUTEUR - 150) && (boss->position.vy > 0)) {
        boss->position.vy = - boss->position.vy;
    }

    // Creation de flammes par le boss
    boss->compteur_apparition_flamme -= cycle;
    if (boss->compteur_apparition_flamme < 0) {
        boss->compteur_apparition_flamme = (rand() % 40 + 80) / 100.0f * TEMPS_MOYEN_EJECTION_FLAMME;
        Bulle *bulle = creerBulle(false, 4);
        bulle->position.x = boss->position.x + 200;
        bulle->position.y = boss->position.y;
        bulle->boule_de_feu = true;
        ajouterBulle(&tete_bulle, bulle);
    }

    // Detection avec le boss
    Balle *balle = tete_balle;
    while (balle != NULL) {
        if (detecterCollision(&boss->position, &balle->position) == true) {
            balle->position.y = HORS_ZONE_JEU; //Supprime la balle grâce à la fonction supprimerBallesHorsZone
            boss->nb_tirs_recus++;
        }
        balle = balle->suivant;
    }
    if (detecterCollision(&joueur->position, &boss->position) == true) {
        joueur_touche_par_boss = true;
    }
}

/* ==================== EXTENSIONS ==================== */

void activerBouclier() {
    compteur_bouclier = TEMPS_OBJET_SUR_JOUEUR;
}

void gererBouclier() {
    compteur_bouclier -= CYCLE;
}

void afficherBouclier() {
    if (compteur_bouclier > 0) {
        afficherSprite(joueur->position.x, joueur->position.y, 120);
    }
}

void activerMalus() {
    compteur_malus = TEMPS_OBJET_SUR_JOUEUR;
}

void gererMalus() {
    compteur_malus -= CYCLE;
    if (compteur_malus > 0) {
        facteur_apparition_bulle = 5;
    } else {
        facteur_apparition_bulle = 1;
    }
}

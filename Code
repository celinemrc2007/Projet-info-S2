    obstacles[3].position.largeur = 200;
    obstacles[3].position.hauteur = HAUTEUR_ECRAN;

    // Deux tailles d'obstacles horizontaux
    obstacles[4].position.largeur = HAUTEUR_ECRAN*15/100;

void supprimerBallesHorsZone(Balle **tete)
{
    Balle *balle = *tete; // temporaire qui commence au debut de la liste
    while (balle != NULL) {
        Balle *suivant = balle->suivant;
        if (balle->position.y<(0+40) | balle->position.x <(0+60) | balle->position.x >(1200-60)) // critere : si la balle dépasse en haut ou sur les cotes de la zone de jeu (en considerant sa taille)
        {
            supprimerBalle(tete, balle);
        }
        balle = suivant;
    }
}



#ifndef PROGRAMMES_LOGIQUEJEU_H
#define PROGRAMMES_LOGIQUEJEU_H

#define N_ARMES 6 //Nombre d'armes
#define CYCLE 0.04f // unité : seconde
#define HORS_ZONE_JEU -500 // // unité : pixels

extern Arme armes[N_ARMES];
extern float temps_restant;
extern Joueur *joueur;
extern Boss *boss;
extern Bulle *tete_bulle;

/* ========== FONCTIONS ========== */

/* Vérifie qu'une bulle venant d'être créée ne chevauche pas d'obstacles */
bool verifierInitialisationSansCollision(Bulle *bulle);

/* Met à jour une bulle pour un frame : gère la gravité, le déplacement, les rebonds et les collisions */
void gererBulle(Bulle *bulle, Joueur *joueur, float cycle);

/* Met à jour la position des balles de la liste et les envoie hors zones si elles touchent un obstacle */
void gererBalle(Balle *tete, float cycle);

/* Gère le rebond d'une bulle contre un obstacle */
void rebondBulleObstacle(Bulle *bulle, const Obstacle *obstacle, float cycle);

/* Affiche les sprites du boss */
void afficherBoss (Boss *boss);

/* Libère la mémoire du boss : supprime les sprites du boss à l'écran */
void supprimerBoss();

/* Affiche les sprites correspondant à l'objet demandé et fais le lien entre le int et le num du sprite */
void afficherObjet(Position *position, int type);

/* Dessine un frame complet : fond d'écran, joueur, bouclier, bulles, balles etc */
void afficherElements();

/* Met à jour tous les éléments du jeu pour un frame */
void animerElements(float cycle);

/* Remplit le tableau global armes[] avec toutes les caractéristiques de chaque arme */
void initialiserArmes ();

/* Initialise tout le jeu pour un niveau */
void init();

/* Boucle principal, appelle init() puis tourne jusqu'a ce que le temps soit écoulé */
bool jeu();

/* Applique l'effet de l'objet que le joueur ramasse */
void collisionJoueurObjet(Objet *objet, Joueur *joueur);

/* Appelle selon le type de bulle et d'armes : divisionBulleEnDeux, divisionBulleEnTrois et eclaterBulle */
void collisionBulleBalle(Bulle *bulle);

/* Détecte la collision entre deux rectangles en comparant les bords des deux */
bool detecterCollision(Position *pos1, Position *pos2);

/* Détecte la collision entre une bulle et un rectangle */
bool detecterCollisionBulle(Bulle *bulle, Position *pos2);

/* Supprime la bulle de la liste et ajoute les points au score selon sa taille */
void eclaterBulle(Bulle *bulle);

/* Décrémente le compteur de durée de l'arme active */
void reinitialiserArme(Joueur *joueur);

/* Crée les bulles de départ d'un niveau */
void initialiserListeBulle(int niveau);

/* Divise une grande bulle en deux moyennes (clones) avec un rayon MOYENNE_BULLE et des vitesses différentes */
void divisionBulleEnDeux(Bulle *bulle);

/* Divise une moyenne bulle en trois petites avec un rayon PETITE_BULLE et des vitesses différentes */
void divisionBulleEnTrois(Bulle *bulle); 

#endif //PROGRAMMES_LOGIQUEJEU_H

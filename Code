    if (balle == NULL)
    {
        printf("Erreur allocation memoire.");
        exit(1);
    }
    balle->angle = angle;
    balle->bazuka = balle_bazuka;
    balle->position.x = x;
    balle->position.y = y;
    balle->position.vx = vx;

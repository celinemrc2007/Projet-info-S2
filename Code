/* ================= VARIABLES GLOBALES ================= */

int niveau = 1;                 // niveau courant
char pseudo[MAX_PSEUDO];
float compteur_bouclier;
float compteur_malus;
int facteur_apparition_bulle;

/* ================= PERMET DE PASSER LE PARAMETRE NIVEAU A CERTAINES SOUS-PROGRAMMES ================= */

int recupererNiveau() {
    return niveau;
}

/* ================= LANCEMENT NIVEAU ================= */

void lancerNiveau() {
    afficherFondEcran(niveau);

    switch (niveau) {
        case 1:
            temps_restant = 120; // 2 min
            break;

        case 2:
            temps_restant = 105; // 1 min 45
            break;

        case 3:
            temps_restant = 90; // 1 min 30
            break;
        case 4:
            temps_restant = 75; // 1 min 15
            break;

          case 5:
            temps_restant = 60; // 1 min
            break;
    }
    afficherNiveau(niveau);
    int resultat_jeu = jeu();
    if (resultat_jeu==true) {
        if (niveau != 4) {
            gererVictoireNiveau ();
        } else {
          jeu();
          //gererBoss();
        }
    } else {
        gererEchecNiveau();
    }
}

/* ================= FIN NIVEAU APRES ANIMATION ================= */
void finNiveau() {
    int choix = 0;
    int choix_realise = 0;

    afficherFondEcran(niveau);
    int x = LARGEUR_ECRAN/2 - 100;
    int y = HAUTEUR_ECRAN/2 - 100;
    int noir = makecol(0, 0, 0);

    textout_ex(screen, font, "Que souhaites-tu faire ?", x, y, noir, -1);
    textout_ex(screen, font, "1. Continuer", x, y + 30, noir, -1);
    textout_ex(screen, font, "2. Sauvegarder et revenir au menu", x, y + 50, noir, -1);
    textout_ex(screen, font, "3. Sauvegarder et quitter le jeu", x, y + 70, noir, -1);
    textout_ex(screen, font, "4. Quitter le jeu sans sauvegarder", x, y + 90, noir, -1);

    while (!choix_realise) {
        if (keypressed()) {
            int touche = readkey();
            char ascii = touche & 0xFF; // Récupération du caractère ASCII

            if (ascii >= '1' && ascii <= '4') {  // Conversion du caractère en chiffre entier
                choix = ascii - '0';
                choix_realise = 1; // On sort de la boucle une fois le choix realise
            }
        }
    }

    switch(choix) {
        case 1:
            lancerNiveau();
            break;
        case 2:
            sauvegarderPartie(pseudo, niveau);
            menu();
            break;
        case 3:
            sauvegarderPartie(pseudo, niveau);
            exit(0);
            break;
        case 4:
            exit(0);
            break;
    }
}

/* ================= VICTOIRE NIVEAU ================= */

void gererVictoireNiveau() {
    if (niveau == 5) {
        gererVictoirePartie();
    } else {
        niveau++;
        afficherVictoireNiveau(joueur);
        finNiveau();
    }
}

/* ================= ECHEC NIVEAU ================= */

void gererEchecNiveau() {
        afficherEchecNiveau(joueur);
        finNiveau();
}

/* ================= VICTOIRE PARTIE ================= */

void gererVictoirePartie() {
    afficherVictoirePartie();
    menu();
}

void gererBoss (Boss *boss, Joueur *joueur) {
    while (boss->nb_tirs_recus == (boss->nb_tirs_recus)++) {
        Bulle *ajouterBulle (Bulle **tete, Bulle *nouveau);
    }
        // à ajouter : si collision entre le joueur et le boss, appeler gererEchecNiveau
    int direction = rand() % 4;

    switch(direction) {
        case 0: // à droite
            boss->position.x += 10;
            break;

        case 1: // à gauche
            boss->position.x -= 10;
            break;

        case 2: // en bas
            boss->position.y += 10;
            break;

        case 3: // en haut
            boss->position.y -= 10;
            break;
    }
}

void activerBouclier() {
    compteur_bouclier = TEMPS_OBJET_SUR_JOUEUR;
}

void gererBouclier() {
    compteur_bouclier -= CYCLE;
}

void afficherBouclier() {
    if (compteur_bouclier > 0) {
        afficherSprite(joueur->position.x, joueur->position.y, 120);
    }
}

void activerMalus() {
    compteur_malus = TEMPS_OBJET_SUR_JOUEUR;
}

void gererMalus() {
    compteur_malus -= CYCLE;
    if (compteur_malus > 0) {
        facteur_apparition_bulle = 5;
    } else {
        facteur_apparition_bulle = 1;
    }
}

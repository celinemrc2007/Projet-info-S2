    obstacles[7].position.largeur = HAUTEUR_ECRAN*3/100;
    obstacles[7].position.hauteur = HAUTEUR_ECRAN*30/100;

    srand(LISTE_SRAND_OBSTACLES[niveau - 1]); // A chaque niveau la disposition des obstacles dans la zone de jeu varie
    // Initialisation des quatre types d'obstacles différents à des positions aléatoires dans la zone de jeu
    for (int i = 4; i < N_OBSTACLES; i++) {
        obstacles[i].position.x = 2*GRANDE_BULLE + rand() % (LARGEUR_ECRAN - obstacles[i].position.largeur - 4*GRANDE_BULLE); // permet que les obstacles soient éloignés du bord
        obstacles[i].position.y = rand() % 400; // permet que les obstacles soient éloignés du bord
    }
    printf("Init terminee\n");
}

bool jeu()
{
    init();
    afficherElements();
    afficherDecompte();
    float temps_depart = temps_restant;
    joueur_touche_par_bulle = false;
    joueur_touche_par_eclair = false;
    clock_t t;

    /*while (verifierInitialisationSansCollision(tete_bulle) == false) {
        initialiserListeBulle(niveau);
    }*/
    while (temps_restant > 0) {
        t = clock();
        afficherElements();
        animerElements(CYCLE);
        deplacementJoueur(joueur);
        tirerBallesBombes(&tete_balle, joueur);
        if ((temps_restant <= temps_depart -TEMPS_JEU_MINIMUM) && (listeVide((void **)&tete_bulle) == true)) {
            return true;
       // } else if (joueur_touche_par_bulle == true) { // Si la bulle touche le joueur, le joueur perd.
           //     return false;
        } else if (joueur_touche_par_eclair == true) { //Si le joueur touche un éclair, il perd.
        return false;
        }
        temps_restant -= CYCLE;
        int diff_t = 1000 * (clock() - t) / CLOCKS_PER_SEC;
        if (diff_t < CYCLE * 1000) {                // Permet un cycle de durée constante
            rest(CYCLE * 1000 - diff_t);
        } else {
            printf("diff t = %d ms\n", diff_t);
        }
    }
    return false;
}


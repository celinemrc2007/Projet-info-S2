Objet *creerObjet(int niveau, Bulle *bulle_contenant_objet )
{
    Objet *objet = malloc(sizeof(Objet)); // allocation dynamique
    if (objet == NULL)
    {
        printf("Erreur allocation memoire.");
        exit(1);
    }
    objet->position = bulle_contenant_objet->position; // l'objet est crée au meme endroit où il tombe de la bulle
    switch (niveau)
    {
        case 1:
        objet->type = rand()%2;
        objet->position.hauteur = (5/100)*HAUTEUR_ECRAN;
        objet->position.largeur = (5/100)*LARGEUR_ECRAN; // taille arme
        break;
        case 2: objet->type = rand()%3;
        objet->position.hauteur = (5/100)*HAUTEUR_ECRAN;
        objet->position.largeur = (5/100)*LARGEUR_ECRAN; // taille arme
        break;
        case 3: objet->type = rand()%5;
        objet->position.hauteur = (5/100)*HAUTEUR_ECRAN;
        objet->position.largeur = (5/100)*LARGEUR_ECRAN; // taille arme et eclair
        break;
        case 4: objet->type = rand()%5;
        objet->position.hauteur = (5/100)*HAUTEUR_ECRAN;
        objet->position.largeur = (5/100)*LARGEUR_ECRAN; // taille arme et eclair
        break;
        case 5: objet->type = rand()%7;
        objet->position.hauteur = (5/100)*HAUTEUR_ECRAN;
        objet->position.largeur = (5/100)*LARGEUR_ECRAN; // bouclier et malus font la meme taille que le reste des objets

        break;
    }
    objet->position.vx = 0;
    objet->position.vy = VITESSE_OBJET; // objet descend verticalement
    objet->duree_restante = TEMPS_OBJET; // ils ne restent que 10 sec à l'ecran
    objet->suivant = NULL;
    return objet; // on retourne l'adresse de l'objet créé
}


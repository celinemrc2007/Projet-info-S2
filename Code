/* ================= LANCEMENT NIVEAU ================= */

void lancerNiveau() {
    printf("init_obstacles");
    srand(LISTE_SRAND_OBSTACLES[niveau - 1]); // A chaque niveau la disposition des obstacles dans la zone de jeu varie

    switch (niveau) {
        case 1:
            afficherFondEcran(1);
            temps_restant = 120; // 2 min
            break;

        case 2:
            afficherFondEcran(2);
            temps_restant = 105; // 1 min 45
            break;

        case 3:
            afficherFondEcran(3);
            temps_restant = 90; // 1 min 30
            break;
        case 4:
            afficherFondEcran(4);
            temps_restant = 75; // 1 min 15
            break;

          case 5:
            afficherFondEcran(5);
            temps_restant = 60; // 1 min
            break;
    }
    afficherNiveau(niveau);
    int resultat_jeu = jeu();
    if (resultat_jeu==true) {
        if (niveau != 4) {
            gererVictoireNiveau ();
        } else {
          jeu();
          //gererBoss();
        }
    } else {
        gererEchecNiveau();
    }
}

/* ================= FIN NIVEAU APRES ANIMATION ================= */
void finNiveau() {
    int choix = 0;
    int choix_realise = 0;

    afficherFondEcran();
    int x = LARGEUR_ECRAN/2 - 100;
    int y = HAUTEUR_ECRAN/2 - 100;
    int blanc = makecol(255, 255, 255);

    textout_ex(screen, font, "Que souhaites-tu faire ?", x, y, blanc, -1);
    textout_ex(screen, font, "1. Continuer", x, y + 30, blanc, -1);
    textout_ex(screen, font, "2. Sauvegarder et revenir au menu", x, y + 50, blanc, -1);
    textout_ex(screen, font, "3. Sauvegarder et quitter le jeu", x, y + 70, blanc, -1);
    textout_ex(screen, font, "4. Quitter le jeu sans sauvegarder", x, y + 90, blanc, -1);

    while (!choix_realise) {
        if (keypressed()) {
            int touche = readkey();
            char ascii = touche & 0xFF; // Récupération du caractère ASCII

            if (ascii >= '1' && ascii <= '4') {  // Conversion du caractère en chiffre entier
                choix = ascii - '0';
                choix_realise = 1; // On sort de la boucle une fois le choix realise
            }
        }
    }

    switch(choix) {
        case 1:
            lancerNiveau();
            break;
        case 2:
            sauvegarderPartie(pseudo, niveau);
            menu();
            break;
        case 3:
            sauvegarderPartie(pseudo, niveau);
            exit(0);
            break;
        case 4:
            exit(0);
            break;
    }
}

/* ================= VICTOIRE NIVEAU ================= */

void gererVictoireNiveau() {
    if (niveau == 5) {
        gererVictoirePartie();
    } else {
        niveau++;
        afficherVictoireNiveau(joueur);
        finNiveau();
    }
}

/* ================= ECHEC NIVEAU ================= */

void gererEchecNiveau() {
        afficherEchecNiveau(joueur);
        finNiveau();
}

/* ================= VICTOIRE PARTIE ================= */

void gererVictoirePartie() {
    afficherVictoirePartie();
    menu();
}

void gererBoss (Boss *boss, Joueur *joueur) {
    while (boss->nb_tirs_recus == (boss->nb_tirs_recus)++) {
        Bulle *ajouterBulle (Bulle **tete, Bulle *nouveau);
    }
        // à ajouter : si collision entre le joueur et le boss, appeler gererEchecNiveau
    int direction = rand() % 4;

    switch(direction) {
        case 0: // à droite
            boss->position.x += 10;
            break;

        case 1: // à gauche
            boss->position.x -= 10;
            break;

        case 2: // en bas
            boss->position.y += 10;
            break;

        case 3: // en haut
            boss->position.y -= 10;
            break;
    }
}


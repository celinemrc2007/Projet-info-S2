void collisionBulleBalle(Bulle *bulle, Balle *balle)
{
    if(bulle->rayon == PETITE_BULLE) // petite bulle
    {
        eclaterBulle(bulle, &tete_bulle, &tete_objet);
    }
    else if(bulle->rayon == MOYENNE_BULLE) // moyenne bulle
    {
        divisionBulleEnTrois(bulle);

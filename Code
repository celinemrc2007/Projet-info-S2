#define VITESSE_OBJET 50

Bulle *creerBulle(bool ApparitionDebutJeu, const int niveau)
{
    Bulle *bulle = malloc(sizeof(Bulle)); // allocation dynamique
    if (bulle == NULL)
    {
        printf("Erreur allocation memoire.");
        exit(1);
    }
    double angle = rand()%1000 + 1; // angle compris entre 1 et 1000
    switch (niveau)
    {
        case 1: bulle->objet = rand () % 1;  // Toutes les bulles sont vides.
            bulle->position.vx = VITESSE_OBJET* cos(angle);
            bulle->position.vy = VITESSE_OBJET* sin(angle);
            break;
        case 2: bulle->objet = rand () % 2; // Ajout d'une nouvelle arme
            //plus le niveau augmente, plus la vitesse augmente
            bulle->position.vx = 1,5*VITESSE_OBJET* cos(angle);
            bulle->position.vy = 1,5*VITESSE_OBJET* sin(angle);
            break;
        case 3: bulle->objet = rand () % 4; // Ajout d'une nouvelle arme et de l'éclair
            bulle->position.vx = 1,75*VITESSE_OBJET* cos(angle);
            bulle->position.vy = 1,75*VITESSE_OBJET* sin(angle);
            break;
        case 4: bulle->objet = rand () % 5; // Ajout d'une nouvelle arme
            bulle->position.vx = 2*VITESSE_OBJET* cos(angle);
            bulle->position.vy = 2*VITESSE_OBJET* sin(angle);
            break;
        case 5: bulle->objet = rand () % 8; // Ajout d'une nouvelle arme, d'un bonus et d'un malus (8 cas posibles dont 7 objets diférents)
            bulle->position.vx = 2,25*VITESSE_OBJET* cos(angle);
            bulle->position.vx = 2,25*VITESSE_OBJET* sin(angle);
            break;
    }

    int rayon; // variable pour un choix aléatoire de rayon
    rayon = 1 + rand()%3;
    switch (rayon)
    {
        case 1:
        bulle->rayon = PETITE_BULLE; // rayon petite bulle : 40 pixel
        bulle->position.largeur = bulle->position.hauteur = 2*bulle->rayon;
        break;
        case 2:
        bulle->rayon = MOYENNE_BULLE; // rayon moyenne bulle : 56 pixel
        bulle->position.largeur = bulle->position.hauteur = 2*bulle->rayon;
        break;
        case 3:
        bulle->rayon = GRANDE_BULLE; // rayon grande bulle : 80 pixel
        bulle->position.largeur = bulle->position.hauteur = 2*GRANDE_BULLE;
        break;
    }

    switch (ApparitionDebutJeu)
    {
        case TRUE: // bulles apparaissent partout dans le jeu
            bulle->position.x = bulle->rayon + rand()%((LARGEUR_ECRAN-bulle->rayon)-bulle->rayon + 1); // position x entre 0+rayon (min) et 1200-rayon (max)
            bulle->position.y = bulle->rayon + rand()%((600-bulle->rayon)-bulle->rayon + 1); // position y entre 0+rayon (min) et 600-rayon (max)(elles n'apparaissent pas jusqu'en bas de l'écran pour des raisons de jouabilité) 
        break;

        case FALSE: // bulles apparaissent que sur les bords
        if (rand() % 2 == 0) // creer choix aléatoire
            bulle->position.x = bulle->rayon; // sur les bors à gauche
        else
            bulle->position.x = LARGEUR_ECRAN - bulle->rayon; // ou à droite
        bulle->position.y = bulle->rayon + rand()%((600-bulle->rayon)-bulle->rayon + 1); // position y entre 0+rayon (min) et 600-rayon (max)(elles n'apparaissent pas jusqu'en bas de l'écran pour des raisons de jouabilité)
        break;
    }
    bulle->boule_de_feu = false; // Par défaut, les bulles ne sont pas des boules de feu puisque cela n'arrive que lors du combat avec le boss.
    bulle->suivant = NULL;
    return bulle; // on retourne l'adresse de la bulle créée
}

Bulle *creerBulleClone(Bulle *original) {
    Bulle *bulle = malloc(sizeof(Bulle)); // allocation dynamique
    if (bulle == NULL)
    {
        printf("Erreur allocation memoire.");
        exit(1);
    }
    bulle->position = original->position;
    bulle->objet = 0;
    bulle->suivant = NULL;
    return bulle;
}

Bulle *ajouterBulle(Bulle **tete, Bulle *nouveau) // ajout en début de liste
{
    //si liste vide
    if (listeVide((void**)tete))
    {
        *tete = nouveau; //tete contient l'adresse de nouveau, nouveau est à la fois premier et dernier
    }
    else
    {
        // ajout en début de liste
        nouveau->suivant = *tete;
        *tete = nouveau; // nouvelle bulle devient la tete
    }
    return nouveau; // on retourne l'adresse de la nouvelle bulle
}


void ajouterBulleAleatoirement(Bulle **tete, int niveau)
{
    // on cherche à calculer une probabilité d'apparition par fréquence d'images (FPS)
    int proba = rand()%100; // variable aléatoire entre 0 et 100
    int seuil;
    switch (niveau)
    {
        case 1: seuil = 3; // 3% de chance d'apparition par image
        break;
        case 2: seuil = 5;
        break;
        case 3: seuil = 8;
        break;
        case 4: seuil = 11;
        break;
        case 5: seuil = 15;
        break;
        default: seuil = 3;
    }
    if (proba < seuil) // on ne depasse pas le seuil de chaque niveau
    {
        // creation bulle
        Bulle *nouvelle = creerBulle(false, niveau);
        // insertion en tête de liste
        ajouterBulle(tete,nouvelle);
    }
}


void supprimerBulle( Bulle **tete, Bulle *bulle) // n'importe laquelle dans la liste
{
    if (!listeVide((void**)tete))
    {
        Bulle *temporaire = *tete; // temporaire qui commence au debut de la liste
        if (temporaire->position.x == bulle->position.x && temporaire->position.y == bulle->position.y) //critere : si temporaire et bulle sont au meme endroit
        {
            *tete = temporaire->suivant; // on fait pointer la tete sur la bulle suivante
            temporaire = NULL; // on rend l'adresse de la bulle pointée nulle pour supprimer la bulle
        }
        else
        {
            *tete = temporaire->suivant; // on déplace la tete
        }
        free(temporaire); // liberation pour pouvoir avancer
    }
}

int supprimerListeBulle(Bulle **tete) // supression de la derniere bulle à la premiere
{
    while (!listeVide((void**)tete)) // tant qu'il y a une liste
    {
        // on libere toutes les bulles
        Bulle *temporaire = *tete; // pour parcourir la liste
        if ((*tete)->suivant == NULL) //si on arrive à la fin de la liste
        {
            *tete = NULL; //on rend l'adresse de la bulle pointée nulle
        }
        else
        {
            *tete = temporaire->suivant; // on avance dans la liste
        }
        free(temporaire); // liberation pour pouvoir avancer
    }
    return 1; // la liste est vide
}


Balle *creerBalle(float x, float y, float vx, float vy) // on prend l'arme grise par défault ?
{
    Balle *balle = malloc(sizeof(Balle)); // allocation dynamique
    if (balle == NULL)
    {
        printf("Erreur allocation memoire.");
        exit(1);
    }
    balle->position.x = x;
    balle->position.y = y;
    balle->position.vx = vx;
    balle->position.vy = vy; // tir horizontal
    balle->position.hauteur = HAUTEUR_ECRAN*4/100;
    balle->position.largeur = LARGEUR_ECRAN*2/100;
    balle->suivant = NULL;
    return balle; // on retourne l'adresse de la balle créée
}


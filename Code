Bulle *ajouterBulle(Bulle **tete, Bulle *nouveau) // ajout en début de liste
{
    //si liste vide
    if (listeVide((void**)tete))
    {
        *tete = nouveau; //tete contient l'adresse de nouveau, nouveau est à la fois premier et dernier
    }
    else
    {
        // ajout en début de liste
        nouveau->suivant = *tete;
        *tete = nouveau; // nouvelle bulle devient la tete
    }
    return nouveau; // on retourne l'adresse de la nouvelle bulle
}


void ajouterBulleAleatoirement(Bulle **tete, int niveau)
{
    // on cherche à calculer une probabilité d'apparition par fréquence d'images (FPS)
    int proba = 0;
    int seuil;
    switch (niveau)
    {
        case 1: seuil = 3; // 3% de chance d'apparition par image
        break;
        case 2: seuil = 5;
        break;
        case 3: seuil = 8;
        break;
        case 4: seuil = 11;
        break;
        case 5: seuil = 15;
        break;
        default: seuil = 3;
    }
    if (proba < seuil) // on ne depasse pas le seuil de chaque niveau
    {
        // creation bulle
        Bulle *nouvelle = creerBulle(false, niveau);
        // insertion en tête de liste
        ajouterBulle(tete,nouvelle);
    }
}


void supprimerBulle( Bulle **tete, Bulle *bulle) // n'importe laquelle dans la liste
{
    if (!listeVide((void**)tete))
    {
        Bulle *temporaire = *tete; // temporaire qui commence au debut de la liste
        if (temporaire->position.x == bulle->position.x && temporaire->position.y == bulle->position.y) //critere : si temporaire et bulle sont au meme endroit
        {
            *tete = temporaire->suivant; // on fait pointer la tete sur la bulle suivante
            temporaire = NULL; // on rend l'adresse de la bulle pointée nulle pour supprimer la bulle
        }
        else
        {
            *tete = temporaire->suivant; // on déplace la tete
        }
        free(temporaire); // liberation pour pouvoir avancer
    }
}

int supprimerListeBulle(Bulle **tete) // supression de la derniere bulle à la premiere
{
    while (!listeVide((void**)tete)) // tant qu'il y a une liste
    {
        // on libere toutes les bulles
        Bulle *temporaire = *tete; // pour parcourir la liste
        if ((*tete)->suivant == NULL) //si on arrive à la fin de la liste
        {
            *tete = NULL; //on rend l'adresse de la bulle pointée nulle
        }
        else
        {
            *tete = temporaire->suivant; // on avance dans la liste
        }
        free(temporaire); // liberation pour pouvoir avancer
    }
    return 1; // la liste est vide
}


Balle *creerBalle(Joueur *joueur) // on prend l'arme grise par défault ?
{
    Balle *balle = malloc(sizeof(Balle)); // allocation dynamique
    if (balle == NULL)
    {
        printf("Erreur allocation memoire.");
        exit(1);
    }
    balle->position.x = joueur->position.x + joueur->position.largeur/3;
    balle->position.y = joueur->position.y + joueur->position.hauteur/2;
    balle->position.vx = 0;
    balle->position.vy = -30; // tir vertical
    balle->position.hauteur = (6/100)*HAUTEUR_ECRAN;
    balle->position.largeur = (2/100)*LARGEUR_ECRAN;
    return balle; // on retourne l'adresse de la balle créée
}


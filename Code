#include <allegro.h>
#include "gestionListes.h"
#include "logiqueJeu.h"
#include "gestionClavier.h"


#define ECART_BALLES_ARME3 HAUTEUR_ECRAN/20


float temps_recharge_arme;

void deplacementJoueur(Joueur *joueur)
{
    joueur->position.vx = 0;
    if (key[KEY_LEFT])
    {
        joueur->position.vx = -VITESSE_JOUEUR;
    }
    if (key[KEY_RIGHT])
    {
        joueur->position.vx = VITESSE_JOUEUR;
    }
    joueur->position.x += joueur->position.vx * CYCLE;
    // limites de deplacement du joueur, le joueur ne dépasse pas les bords
    if (joueur->position.x < joueur->position.largeur/2) joueur->position.x = joueur->position.largeur/2;
    if (joueur->position.x > LARGEUR_ECRAN - joueur->position.largeur/2) joueur->position.x = LARGEUR_ECRAN - (joueur->position.largeur)/2;
}

void tirerBallesBombes(Balle **listeBalle, Joueur *joueur)
{
    temps_recharge_arme -= CYCLE;
    if ((!key[KEY_UP]) || (temps_recharge_arme > 0)) {
        return;
    }
    float ox = joueur->position.x ;
    float oy = joueur->position.y - 80;

    float v  = armes[joueur->arme].vitesse;
    float d  = 0.7071f;

    switch (joueur->arme) {

        case ARME1:
            ajouterBalle(listeBalle, creerBalle(ox, oy, 0.0f, -v, false, 0));
            break;
        case ARME2:
            ajouterBalle(listeBalle, creerBalle( ox, oy, 0.0f, -v, false, 0));
            break;
        case ARME3:
            ajouterBalle(listeBalle, creerBalle(ox - ECART_BALLES_ARME3, oy, 0.0f, -v, false, 0));
            ajouterBalle(listeBalle, creerBalle(ox,                       oy, 0.0f, -v, false, 0));
            ajouterBalle(listeBalle, creerBalle(ox + ECART_BALLES_ARME3, oy, 0.0f, -v, false, 0));
            break;
        case ARME4:
            ajouterBalle(listeBalle, creerBalle(ox, oy,  0.0f,    -v, false, 0));
            ajouterBalle(listeBalle, creerBalle(ox, oy, -v * d,   -v * d, false, -32));
            ajouterBalle(listeBalle, creerBalle(ox, oy,  v * d,   -v * d, false, 32));
            break;
        case ARME5:
            ajouterBalle(listeBalle, creerBalle(ox, oy, 0.0f, -v, true, 0));
            break;
        default:
            ajouterBalle(listeBalle, creerBalle(ox, oy, 0.0f, -v, false, 0));
            break;
    }
    if (armes[joueur->arme].bazuka == true) {
        temps_recharge_arme = 1;
    } else {
        temps_recharge_arme = 0.2f;
    }
}

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <allegro.h>


#include "gestionGraphique.h"
#include "gestionNiveaux.h"
#include "sauvegarde.h"


int menu()
{
    int choix = 0;

    while (choix < 1 || choix > 4)
    {
        clear_bitmap(screen);

        textprintf_centre_ex(screen, font, LARGEUR_ECRAN/2, 150, makecol(255,255,0), -1, "SUPER BULLES");
        textprintf_centre_ex(screen, font, LARGEUR_ECRAN/2, 250, makecol(255,255,255), -1, "1. Regles");
        textprintf_centre_ex(screen, font, LARGEUR_ECRAN/2, 300, makecol(255,255,255), -1, "2. Nouvelle partie");
        textprintf_centre_ex(screen, font, LARGEUR_ECRAN/2, 350, makecol(255,255,255), -1, "3. Reprendre");
        textprintf_centre_ex(screen, font, LARGEUR_ECRAN/2, 400, makecol(255,255,255), -1, "4. Quitter");

        /* Lecture de la touche */
        int touche = readkey() & 0xff;

        /* Conversion caractère en nombre */
        choix = touche - '0';
    }

    return choix;
}


void saisirPseudo()
{
    int longueur = 0;
    int touche;

    memset(pseudo, 0, MAX_PSEUDO);

    clear_bitmap(screen);
    textprintf_centre_ex(screen, font, LARGEUR_ECRAN/2, 200, makecol(255,255,255), -1, "Entrez votre pseudo :");

    while (1)
    {
        /* Affichage du pseudo */
        textprintf_centre_ex(screen, font, LARGEUR_ECRAN/2, 260, makecol(255,220,0), -1, "%s_", pseudo);

        touche = readkey() & 0xff;

        if (touche == 13 && longueur > 0) // Touche Entrée = 13 en ASCII
        {
            break;
        }

        else if (touche == 8 && longueur > 0) // Touche Effacer = 8 en ASCII
        {
            longueur--;
            pseudo[longueur] = '\0';

            clear_bitmap(screen);
            textprintf_centre_ex(screen, font, LARGEUR_ECRAN/2, 200, makecol(255,255,255), -1, "Entrez votre pseudo :");
        }
        /* Caractère normal */
        else if (longueur < MAX_PSEUDO - 1 && touche >= 32 && touche <= 126)
        {
            pseudo[longueur] = (char)touche;
            longueur++;
            pseudo[longueur] = '\0';
        }
    }
}


int main()
{
    int choix;

    srand(time(NULL));

    initialisation_allegro();
    chargerSprites();

    do
    {
        choix = menu();

        switch (choix)
        {
            case 1:
            	/* Afficher les regles */
                afficherRegles();
                break;

            case 2:
                /* Nouvelle partie */
                //saisirPseudo();
                niveau = 1;
                lancerNiveau();
                break;

            case 3:
                /* Reprendre une partie */
                saisirPseudo();

                if (chargerPartie(pseudo, &niveau))
                {
                    lancerNiveau();
                }
                else
                {
                	clear_bitmap(screen);
                    textprintf_centre_ex(screen, font, LARGEUR_ECRAN/2, 300, makecol(255,0,0), -1, "Aucune sauvegarde ");
                    readkey();
                }
                break;

            case 4:
                /* Quitter le programme */
                break;
        }

    } while (choix != 4);

    detruireSprites();

    allegro_exit();
    return 0;
}

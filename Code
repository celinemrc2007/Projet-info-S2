#ifndef PROGRAMMES_GESTIONLISTES_H
#define PROGRAMMES_GESTIONLISTES_H

#include <stdbool.h>

#define PETITE_BULLE 40
#define MOYENNE_BULLE 56
#define GRANDE_BULLE 80 // RAYON
#define LARGEUR_ECRAN 1200
#define HAUTEUR_ECRAN 800
#define TEMPS_OBJET_SUR_JOUEUR 10 // temps pour lequel l'objet est sur le joueur
#define TEMPS_OBJET_AU_SOL 2 // temps pour lequel l'objet peut être récupéré au sol

// Type d'objets
#define ARME1 0
#define ARME2 1
#define ARME3 2
#define ECLAIR 3
#define ARME4 4
#define ARME5 5
#define BONUS 6
#define MALUS 7

/* ======= STRUCTURES ======= */

// Structure générale
typedef struct position
{
    float x; // centre de l'objet ( axe x vers la droite)
    float y; // centre de l'objet (attention axe y est vers le bas!)
    float vx; //vitesse
    float vy;
    int largeur;
    int hauteur;
} Position;

typedef struct {
    Position position;
    int arme; // voir les defines
} Joueur;

typedef struct {
    int nb_tirs;
    int vitesse;
    bool vertical; //Si ce booléen vaut true, tous les tirs sont verticaux vers le haut. Sinon, il peut y avoir des tirs diagonaux.
    bool bazuka;
} Arme;

// Structure Bulle
typedef struct bulle
{
    Position position; // position de la bulle
    int rayon; // il y a 3 tailles
    int objet; // voir dans les defines
    bool boule_de_feu; // permet de savoir quel sprites afficher : si on combat le boss, ce booléen est à true
    // et on affiche les sprites boules de feu. Sinon, on affiche les bulles dans afficherElements
    struct bulle *suivant; // pointeur vers la structure bulle suivante
} Bulle;

//Les obstacles présents dans la zone de jeu ne seront pas alloués dynamiquement 
//mais seront stockés dans un tableau statique puisque leurs positions ne varient pas durant la partie.
// Structure Obstacle
typedef struct obstacle {
    Position position;
} Obstacle;

// Structure Objet
typedef struct objet
{
    Position position; // position de l'objet
    int type; //  0:rien -- 1 : arme2 -- 2: arme3 -- 3:éclair -- 4: arme4 -- 5:arme5 -- 6:bonus -- 7:malus
    float duree_restante; // durée restante d'activation de l'objet
    struct objet *suivant; // pointeur vers la structure objet suivante
}Objet;

// Structure Balle
typedef struct balle
{
    Position position; // position de la balle
    int angle; //256 = 360 degrés
    bool bazuka;
    struct balle *suivant; // pointeur vers la structure balle suivante
} Balle;

typedef struct boss
{
    Position position; // position du boss
    int nb_tirs_recus; // nb_de_tirs_recus par le joueur
    float compteur_changement_vitesse;
    float compteur_apparition_flamme;
} Boss;

extern float compteur_creation_bulle;

/* ======= FONCTIONS =======*/

/* Allocatiion dynamique d'une structure bulle et initialisation de ses paramètres */
Bulle *creerBulle(bool ApparitionDebutJeu, int niveau);

/* A quoi ça sert */
Bulle *creerBulleClone(Bulle *original);

/* Insertion d'une bulle en tête de liste */
Bulle *ajouterBulle(Bulle **tete, Bulle *nouveau);

/* Définition d'une probabilité d'apparition des bulles de plus en plus élévée en fonction du niveau */
void ajouterBulleAleatoirement(Bulle **tete, int niveau, float cycle_avec_malus);

/* Supression de n'importe quelle bulle dans la liste */
void supprimerBulle( Bulle **tete, Bulle *bulle);

/* Supression de la liste de bulles */ 
int supprimerListeBulle(Bulle **tete);

/* Allocation dynamique d'une structure balle et initialisation de ses paramètres */
Balle *creerBalle(float x, float y, float vx, float vy, bool balle_bazuka, int angle);

/* Insertion d'une balle en tête de liste */
Balle *ajouterBalle(Balle **tete, Balle *nouveau);

/* Supression de n'importe quelle balle dans la liste */
void supprimerBalle(Balle **tete, Balle *balle);

/* Supression des balles sortant de la zone de jeu */
void supprimerBallesHorsZone(Balle **tete);

/* Supression de la liste de balles */
int supprimerListeBalle(Balle **tete);

/* Allocation dynamique d'une structure objet et initialisation de ses parapètres */
Objet *creerObjet(Bulle *bulle_contenant_objet);

/* Insertion d'un objet en tête de liste */
Objet *ajouterObjet(Objet **tete, Objet *nouveau);

/* Supression de n'importe quel objet dans la liste */
void supprimerObjet(Objet **tete, Objet *objet);

/* Supression de la liste d'objets */
int supprimerListeObjet(Objet **tete);

/* Allocation dynamique d'une structure boss et initialisatiion de ses paramètres */
Boss *creerBoss();

/* Vérification qu'une liste est vide ou non */
bool listeVide(void **tete);


#endif
